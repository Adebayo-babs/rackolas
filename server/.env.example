PORT=3500

# Comma-separated list of allowed origins (only needed if the
# frontend is hosted separately, e.g. on Vercel)
CORS_ORIGIN=

# Secret used to view quote requests at GET /api/quotes
ADMIN_TOKEN=change-me-to-a-long-random-string

# Where new quote requests are emailed (comma-separate for more)
NOTIFY_EMAIL=

# --- Option A: Brevo (free, works on Render free plan) ---
# brevo.com > SMTP & API > API Keys
BREVO_API_KEY=
# A sender email you verified in Brevo (Senders & IP)
MAIL_FROM=

# --- Option B: SMTP (paid hosting / VPS only) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
